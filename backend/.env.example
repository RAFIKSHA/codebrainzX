# Django Backend — Production Environment Template
# Copy this to .env and fill in real values for production

# Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1

# Supabase PostgreSQL (Production)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Judge0 Compiler (Self-hosted on DigitalOcean)
JUDGE0_API_URL=http://YOUR_DROPLET_IP:2358
JUDGE0_API_KEY=
